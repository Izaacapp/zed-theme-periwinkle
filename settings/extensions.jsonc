// Extensions from the original setup, as an `auto_install_extensions` block.
// Paste into settings.json — Zed installs anything missing on next launch.
// Only `fantasticons-icons-theme` is needed for the look; the rest is the
// full kit. Delete any lines you don't want before pasting.
{
  "auto_install_extensions": {
    // ── Required for the look ──
    "fantasticons-icons-theme": true,

    // ── Languages ──
    "actionscript": true,
    "angular": true,
    "ansible": true,
    "astro": true,
    "coffeescript": true,
    "cql": true,
    "csv": true,
    "dart": true,
    "django": true,
    "dockerfile": true,
    "elixir": true,
    "erlang": true,
    "gdscript": true,
    "git-firefly": true,
    "github-actions": true,
    "gleam": true,
    "graphql": true,
    "graphviz": true,
    "helm": true,
    "html": true,
    "html-jinja": true,
    "http": true,
    "java": true,
    "jsonnet": true,
    "just": true,
    "latex": true,
    "lean4": true,
    "log": true,
    "lua": true,
    "make": true,
    "mdx": true,
    "neocmake": true,
    "nginx": true,
    "ocaml": true,
    "perl": true,
    "powershell": true,
    "prisma": true,
    "proto": true,
    "purescript": true,
    "r": true,
    "rainbow-csv": true,
    "rst": true,
    "scheme": true,
    "scss": true,
    "sql": true,
    "svelte": true,
    "swift": true,
    "terraform": true,
    "toml": true,
    "tree-sitter-query": true,
    "typst": true,
    "vue": true,
    "zig": true,

    // ── LSPs & dev tools ──
    // discord-presence shows your open file/project on your Discord profile.
    "color-highlight": true,
    "crates-lsp": true,
    "css-modules-kit": true,
    "css-variables": true,
    "dependi": true,
    "discord-presence": true,
    "markdown-oxide": true,
    "markdownlint": true,
    "npm-package-json-checker": true,
    "texpresso": true,

    // ── Snippet packs ──
    "comment-block-snippets": true,
    "django-snippets": true,
    "elixir-snippets": true,
    "fastapi-snippets": true,
    "flask-snippets": true,
    "flutter-snippets": true,
    "gleam-snippets": true,
    "go-snippets": true,
    "html-snippets": true,
    "javascript-snippets": true,
    "keep-a-changelog-snippets": true,
    "kubernetes-snippets": true,
    "live-template": true,
    "markdown-snippets": true,
    "python-snippets": true,
    "react-typescript-snippets": true,
    "rust-snippets": true,
    "sqlc-snippets": true,
    "svelte-snippets": true,
    "typescript-snippets": true,
    "vitest-snippets": true,

    // ── Other themes in rotation ──
    "aquarium-theme": true,
    "blade-runner-2049": true,
    "catppuccin-blur": true,
    "claude-code-inspired-dark": true,
    "colorizer": true,
    "ezio-theme": true,
    "gleam-theme": true,
    "hex-light-theme": true,
    "ibm-5151": true,
    "material-dark": true,
    "monokai-nebula": true,
    "nvim-nightfox": true,
    "oceanic-next": true,
    "panda-theme": true,
    "rose-pine-theme": true,
    "sequoia": true,
    "smooth": true,
    "snowfall": true,
    "tailwind-theme": true,
    "min-theme": true,

    // ── Other icon themes ──
    "catppuccin-icons": true,
    "charmed-icons": true,
    "clean-vscode-icons": true,
    "icons-modern-material": true,
    "material-icon-theme": true,
    "modern-icons": true,
    "nube-icons": true,
    "symbols": true
  }
}
